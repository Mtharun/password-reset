# Server
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/password-reset?retryWrites=true&w=majority

# The deployed front-end URL (Netlify). The password-reset link emailed to
# the user points to <CLIENT_URL>/reset-password/<token>
CLIENT_URL=http://localhost:5173

# How long (in minutes) a password reset link stays valid before it expires
RESET_TOKEN_EXPIRY_MINUTES=15

# --- Email (Brevo transactional email API) ---
# Sent over HTTPS (not raw SMTP), so it works the same locally AND once
# deployed — Render's free tier blocks outbound SMTP ports, which is why
# this project doesn't use Nodemailer/SMTP directly.
#   1. Create a free account at https://www.brevo.com/ (no credit card needed)
#   2. Go to Senders, Domains & Dedicated IPs -> Senders -> add your Gmail
#      address as a sender, and click the confirmation link Brevo emails you
#   3. Go to SMTP & API -> API Keys -> Generate a new API key, copy it below
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Password Reset
